<?xml version="1.0" encoding="UTF-8"?>
<xbrl
    xmlns="http://www.xbrl.org/2003/instance"
    xmlns:xbrli="http://www.xbrl.org/2003/instance"
    xmlns:xbrldi="http://xbrl.org/2006/xbrldi"
    xmlns:link="http://www.xbrl.org/2003/linkbase"
    xmlns:xlink="http://www.w3.org/1999/xlink"
    xmlns:my="http://www.example.com/dimension"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.example.com/dimension taxonomy.xsd">

    <link:schemaRef xlink:href="taxonomy.xsd" xlink:type="simple"/>

    <context id="cd">
        <entity>
            <identifier scheme="http://www.example.com/id">Example Corp</identifier>
        </entity>
        <period>
            <startDate>2001-01-01</startDate>
            <endDate>2001-12-31</endDate>
        </period>
        <scenario>
            <xbrldi:explicitMember dimension="my:regionAxis">my:franceMember</xbrldi:explicitMember>
        </scenario>
    </context>

    <my:salesText contextRef="cd">Revenue text</my:salesText>
</xbrl>
