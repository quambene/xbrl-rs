<?xml version="1.0" encoding="UTF-8"?>
<xbrl
    xmlns="http://www.xbrl.org/2003/instance"
    xmlns:xbrli="http://www.xbrl.org/2003/instance"
    xmlns:link="http://www.xbrl.org/2003/linkbase"
    xmlns:xlink="http://www.w3.org/1999/xlink"
    xmlns:iso4217="http://www.xbrl.org/2003/iso4217"
    xmlns:my="http://www.example.com/calc"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.example.com/calc taxonomy.xsd">

    <link:schemaRef xlink:href="taxonomy.xsd" xlink:type="simple"/>

    <context id="ci">
        <entity>
            <identifier scheme="http://www.example.com/id">Example Corp</identifier>
        </entity>
        <period>
            <instant>2001-08-16</instant>
        </period>
    </context>

    <unit id="EUR">
        <measure>iso4217:EUR</measure>
    </unit>

    <my:totalAmount contextRef="ci" unitRef="EUR" decimals="0">100</my:totalAmount>
    <my:partA contextRef="ci" unitRef="EUR" decimals="0">60</my:partA>
    <my:partB contextRef="ci" unitRef="EUR" decimals="0">40</my:partB>
</xbrl>
