<?xml version="1.0" encoding="UTF-8"?>
<xbrl
    xmlns="http://www.xbrl.org/2003/instance"
    xmlns:xbrli="http://www.xbrl.org/2003/instance"
    xmlns:link="http://www.xbrl.org/2003/linkbase"
    xmlns:xlink="http://www.w3.org/1999/xlink"
    xmlns:my="http://www.example.com/schema-pure-with-unit"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.example.com/schema-pure-with-unit taxonomy.xsd">

    <link:schemaRef xlink:href="taxonomy.xsd" xlink:type="simple"/>

    <context id="ci">
        <entity>
            <identifier scheme="http://www.example.com/id">Example Corp</identifier>
        </entity>
        <period>
            <instant>2001-08-16</instant>
        </period>
    </context>

    <unit id="u-pure">
        <measure>xbrli:pure</measure>
    </unit>

    <my:ratio contextRef="ci" unitRef="u-pure" decimals="2">0.42</my:ratio>
</xbrl>
